<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE FixtureDefinition>
<FixtureDefinition xmlns="http://www.qlcplus.org/FixtureDefinition">
 <Creator>
  <Name>Q Light Controller Plus</Name>
  <Version>4.12.4</Version>
  <Author>matte</Author>
 </Creator>
 <Manufacturer>LEAM</Manufacturer>
 <Model>LASER 1W</Model>
 <Type>Laser</Type>
 <Channel Name="Mode">
  <Group Byte="0">Shutter</Group>
  <Capability Min="0" Max="63" Preset="LampOff">Laser Off</Capability>
  <Capability Min="64" Max="127">Auto Mode</Capability>
  <Capability Min="128" Max="191">Sound Mode</Capability>
  <Capability Min="192" Max="255">DMX Mode</Capability>
 </Channel>
 <Channel Name="Pattern">
  <Group Byte="0">Beam</Group>
  <Capability Min="0" Max="255">Pattern</Capability>
 </Channel>
 <Channel Name="rotator" Preset="PrismRotationSlowFast"/>
 <Channel Name="Point Speed">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">Point Speed</Capability>
 </Channel>
 <Channel Name="Horizontal movement" Preset="PositionPan"/>
 <Channel Name="Vertical movement" Preset="PositionTilt"/>
 <Channel Name="Zoom" Preset="BeamZoomSmallBig"/>
 <Channel Name="Colour">
  <Group Byte="0">Colour</Group>
  <Capability Min="0" Max="39">Yellow</Capability>
  <Capability Min="40" Max="79">Red</Capability>
  <Capability Min="80" Max="119">Green</Capability>
  <Capability Min="120" Max="159">Original Pattern</Capability>
  <Capability Min="160" Max="199">Pattern Colours are Changed</Capability>
 </Channel>
 <Channel Name="Reset">
  <Group Byte="0">Maintenance</Group>
  <Capability Min="0" Max="255" Preset="ResetAll">(Above 200 Shortly)</Capability>
 </Channel>
 <Channel Name="sine wave">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">sine wave</Capability>
 </Channel>
 <Channel Name="puntini">
  <Group Byte="0">Intensity</Group>
  <Capability Min="0" Max="63">normal</Capability>
  <Capability Min="64" Max="127">shinning point</Capability>
  <Capability Min="128" Max="191">line</Capability>
  <Capability Min="192" Max="255">point</Capability>
 </Channel>
 <Mode Name="Default">
  <Channel Number="0">Mode</Channel>
  <Channel Number="1">Pattern</Channel>
  <Channel Number="2">rotator</Channel>
  <Channel Number="3">Point Speed</Channel>
  <Channel Number="4">Horizontal movement</Channel>
  <Channel Number="5">Vertical movement</Channel>
  <Channel Number="6">Zoom</Channel>
  <Channel Number="7">Colour</Channel>
  <Channel Number="8">Reset</Channel>
  <Channel Number="9">sine wave</Channel>
 </Mode>
 <Mode Name="laser 1w">
  <Channel Number="0">Mode</Channel>
  <Channel Number="1">Pattern</Channel>
  <Channel Number="2">Colour</Channel>
  <Channel Number="3">Horizontal movement</Channel>
  <Channel Number="4">Vertical movement</Channel>
  <Channel Number="5">Point Speed</Channel>
  <Channel Number="6">Reset</Channel>
  <Channel Number="7">rotator</Channel>
  <Channel Number="8">Zoom</Channel>
  <Channel Number="9">sine wave</Channel>
  <Channel Number="10">puntini</Channel>
 </Mode>
 <Physical>
  <Bulb Type="LED" Lumens="0" ColourTemperature="0"/>
  <Dimensions Weight="3.8" Width="265" Height="125" Depth="192"/>
  <Lens Name="Other" DegreesMin="0" DegreesMax="0"/>
  <Focus Type="Fixed" PanMax="40" TiltMax="40"/>
  <Technical PowerConsumption="40" DmxConnector="3-pin"/>
 </Physical>
</FixtureDefinition>
