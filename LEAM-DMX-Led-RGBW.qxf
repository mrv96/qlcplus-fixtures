<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE FixtureDefinition>
<FixtureDefinition xmlns="http://www.qlcplus.org/FixtureDefinition">
 <Creator>
  <Name>Q Light Controller Plus</Name>
  <Version>4.12.5</Version>
  <Author>Matte</Author>
 </Creator>
 <Manufacturer>LEAM</Manufacturer>
 <Model>DMX Led</Model>
 <Type>Color Changer</Type>
 <Channel Name="Red">
  <Group Byte="0">Intensity</Group>
  <Colour>Red</Colour>
  <Capability Min="0" Max="255"></Capability>
 </Channel>
 <Channel Name="Green">
  <Group Byte="0">Intensity</Group>
  <Colour>Green</Colour>
  <Capability Min="0" Max="255"></Capability>
 </Channel>
 <Channel Name="Blue">
  <Group Byte="0">Intensity</Group>
  <Colour>Blue</Colour>
  <Capability Min="0" Max="255"></Capability>
 </Channel>
 <Channel Name="Master Dimmer">
  <Group Byte="0">Intensity</Group>
  <Capability Min="0" Max="255"></Capability>
 </Channel>
 <Channel Name="Color Mode">
  <Group Byte="0">Colour</Group>
  <Capability Min="0" Max="10" Preset="ColorMacro" Res1="#ff0000">Red</Capability>
  <Capability Min="11" Max="20" Preset="ColorMacro" Res1="#55ff00">Green</Capability>
  <Capability Min="21" Max="30">Blue</Capability>
  <Capability Min="31" Max="40" Preset="ColorMacro" Res1="#5500ff">Purple</Capability>
  <Capability Min="41" Max="50" Preset="ColorMacro" Res1="#ffff00">Yellow</Capability>
  <Capability Min="51" Max="60" Preset="ColorMacro" Res1="#ffffff">White</Capability>
  <Capability Min="61" Max="70" Preset="ColorMacro" Res1="#00ffff">Cyan</Capability>
  <Capability Min="71" Max="80" Preset="ColorMacro" Res1="#ff00ff">Magenta</Capability>
  <Capability Min="81" Max="90" Preset="ColorMacro" Res1="#ff5500">Orange</Capability>
  <Capability Min="91" Max="100" Preset="ColorMacro" Res1="#ffaaff">Pink</Capability>
  <Capability Min="101" Max="177" Preset="ColorMacro" Res1="#ffaaff">Fade Color</Capability>
  <Capability Min="178" Max="255">Jump Color</Capability>
 </Channel>
 <Channel Name="Strobo">
  <Group Byte="0">Shutter</Group>
  <Capability Min="0" Max="255"></Capability>
 </Channel>
 <Channel Name="White" Preset="IntensityWhite"/>
 <Mode Name="4 Canali">
  <Channel Number="0" ActsOn="0">Red</Channel>
  <Channel Number="1" ActsOn="1">Green</Channel>
  <Channel Number="2" ActsOn="2">Blue</Channel>
  <Channel Number="3" ActsOn="3">White</Channel>
 </Mode>
 <Mode Name="3+1">
  <Channel Number="0" ActsOn="0">Red</Channel>
  <Channel Number="1" ActsOn="1">Green</Channel>
  <Channel Number="2" ActsOn="2">Blue</Channel>
  <Channel Number="3" ActsOn="3">Master Dimmer</Channel>
 </Mode>
 <Physical>
  <Bulb Type="" Lumens="0" ColourTemperature="0"/>
  <Dimensions Weight="0" Width="0" Height="0" Depth="0"/>
  <Lens Name="Other" DegreesMin="0" DegreesMax="0"/>
  <Focus Type="Fixed" PanMax="0" TiltMax="0"/>
  <Technical PowerConsumption="0" DmxConnector="5-pin"/>
