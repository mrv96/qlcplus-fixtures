  <Capability Min="176" Max="191">Color fade 3</Capability>
  <Capability Min="192" Max="207">Color fade 4</Capability>
  <Capability Min="208" Max="223">Color fade 5</Capability>
  <Capability Min="224" Max="239">Color fade 6</Capability>
  <Capability Min="240" Max="255">Color fade 7</Capability>
 </Channel>
 <Channel Name="Color flow speed">
  <Group Byte="0">Speed</Group>
  <Capability Min="0" Max="255" Preset="SlowToFast">Color flow (Slow to fast)</Capability>
 </Channel>
 <Channel Name="Functions">
  <Group Byte="0">Maintenance</Group>
  <Capability Min="0" Max="5">No function</Capability>
  <Capability Min="6" Max="10">Show 1</Capability>
  <Capability Min="11" Max="20">Show 2</Capability>
  <Capability Min="21" Max="30">Show 3</Capability>
