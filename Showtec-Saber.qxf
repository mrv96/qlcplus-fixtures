<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE FixtureDefinition>
<FixtureDefinition xmlns="http://www.qlcplus.org/FixtureDefinition">
 <Creator>
  <Name>Q Light Controller Plus</Name>
  <Version>4.13.1</Version>
  <Author>mrv96</Author>
 </Creator>
 <Manufacturer>Showtec</Manufacturer>
 <Model>Saber</Model>
 <Type>Moving Head</Type>
 <Channel Name="Pan" Preset="PositionPan"/>
 <Channel Name="Pan fine" Preset="PositionPanFine"/>
 <Channel Name="Tilt" Preset="PositionTilt"/>
 <Channel Name="Tilt fine" Preset="PositionTiltFine"/>
 <Channel Name="Pan/Tilt speed" Preset="SpeedPanTiltFastSlow"/>
 <Channel Name="Continuous pan">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="15">No function</Capability>
  <Capability Min="16" Max="135" Preset="RotationClockwiseSlowToFast">Clockwise rotation (Slow to fast)</Capability>
  <Capability Min="136" Max="255" Preset="RotationCounterClockwiseSlowToFast">Counterclockwise rotation (Slow to fast)</Capability>
 </Channel>
 <Channel Name="Continuous tilt">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="15">No function</Capability>
  <Capability Min="16" Max="135" Preset="RotationClockwiseSlowToFast">Clockwise rotation (Slow to fast)</Capability>
  <Capability Min="136" Max="255" Preset="RotationCounterClockwiseSlowToFast">Counterclockwise rotation (Slow to fast)</Capability>
 </Channel>
 <Channel Name="Dimmer" Preset="IntensityMasterDimmer"/>
 <Channel Name="Linear strobe">
  <Group Byte="0">Shutter</Group>
  <Capability Min="0" Max="10">Off</Capability>
  <Capability Min="11" Max="255" Preset="StrobeSlowToFast">Strobe (Slow to fast)</Capability>
 </Channel>
 <Channel Name="Random strobe">
  <Group Byte="0">Shutter</Group>
  <Capability Min="0" Max="10">Off</Capability>
  <Capability Min="11" Max="255" Preset="StrobeRandomSlowToFast">Random Strobe (Slow to fast)</Capability>
 </Channel>
 <Channel Name="Strobe">
  <Group Byte="0">Shutter</Group>
  <Capability Min="0" Max="10" Preset="ShutterOpen">Off</Capability>
  <Capability Min="11" Max="128" Preset="StrobeRandomSlowToFast">Random strobe (Slow to fast)</Capability>
  <Capability Min="129" Max="255" Preset="StrobeSlowToFast">Linear strobe (Slow to fast)</Capability>
 </Channel>
 <Channel Name="Color macro">
  <Group Byte="0">Colour</Group>
  <Capability Min="0" Max="7">No function</Capability>
  <Capability Min="8" Max="13" Preset="ColorMacro" Res1="#ff0000">Color 1</Capability>
  <Capability Min="14" Max="20" Preset="ColorMacro" Res1="#ff3131">Color 2</Capability>
  <Capability Min="21" Max="27" Preset="ColorMacro" Res1="#ff6363">Color 3</Capability>
