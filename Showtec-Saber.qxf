  <Capability Min="231" Max="255" Preset="ColorMacro" Res1="#ffffff">Color 33</Capability>
 </Channel>
 <Channel Name="Color flow">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="15">No function</Capability>
  <Capability Min="16" Max="31">Color jump 1</Capability>
  <Capability Min="32" Max="47">Color jump 2</Capability>
  <Capability Min="48" Max="63">Color jump 3</Capability>
  <Capability Min="64" Max="79">Color jump 4</Capability>
  <Capability Min="80" Max="95">Color jump 5</Capability>
  <Capability Min="96" Max="111">Color jump 6</Capability>
  <Capability Min="144" Max="159">Color fade 1</Capability>
