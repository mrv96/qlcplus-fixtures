  <Capability Min="81" Max="90">Slave 1</Capability>
  <Capability Min="91" Max="96">Slave 2</Capability>
  <Capability Min="97" Max="160" Preset="SmallToBig">Sound sensitivity (Low to high)</Capability>
  <Capability Min="161" Max="170">Pan invert</Capability>
  <Capability Min="171" Max="180">Tilt invert</Capability>
  <Capability Min="181" Max="190">Pan normal</Capability>
  <Capability Min="191" Max="200">Tilt normal</Capability>
  <Capability Min="201" Max="220">Blackout during pan/tilt movement</Capability>
  <Capability Min="221" Max="240">Reset (after 5 seconds)</Capability>
  <Capability Min="241" Max="255">No function</Capability>
 </Channel>
 <Channel Name="Red color intensity" Preset="IntensityDimmer"/>
 <Channel Name="Green color intensity" Preset="IntensityDimmer"/>
 <Channel Name="Blue color intensity" Preset="IntensityDimmer"/>
 <Channel Name="White color intensity" Preset="IntensityDimmer"/>
