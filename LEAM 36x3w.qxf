  <Capability Min="0" Max="255">Tilt (0°-220°)</Capability>
 </Channel>
 <Channel Name="Pan/Tilt Speed">
  <Group Byte="0">Speed</Group>
  <Capability Min="0" Max="255">Speed (Fast-slow)</Capability>
 </Channel>
 <Channel Name="Dimmer">
  <Group Byte="0">Intensity</Group>
  <Capability Min="0" Max="255">0%-100%</Capability>
 </Channel>
 <Channel Name="Red">
