 <Channel Name="Stop / Strobe">
  <Group Byte="0">Shutter</Group>
  <Capability Min="0" Max="7">Closed</Capability>
  <Capability Min="8" Max="15">Open</Capability>
  <Capability Min="16" Max="200">Strobe (slow 1 flash/sec to fast 12 flashes/sec)</Capability>
  <Capability Min="201" Max="255">Open</Capability>
 </Channel>
 <Channel Name="Dimmer">
  <Group Byte="0">Intensity</Group>
  <Capability Min="0" Max="255">Intensity 0 to 100%</Capability>
 </Channel>
 <Channel Name="Static Gobo Change">
