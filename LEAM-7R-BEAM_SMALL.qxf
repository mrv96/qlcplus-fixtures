  <Capability Min="128" Max="191">16 FACES</Capability>
  <Capability Min="192" Max="255">24 FACES</Capability>
 </Channel>
 <Channel Name="Prism Rotation">
  <Group Byte="0">Prism</Group>
  <Capability Min="0" Max="127">Prism Angle</Capability>
  <Capability Min="128" Max="191">Rotating clockwise</Capability>
  <Capability Min="192" Max="255">Rotating anticlockwise</Capability>
 </Channel>
