<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE FixtureDefinition>
<FixtureDefinition xmlns="http://www.qlcplus.org/FixtureDefinition">
 <Creator>
  <Name>Q Light Controller Plus</Name>
  <Version>4.13.1</Version>
  <Author>mrv96</Author>
 </Creator>
 <Manufacturer>Miner Light</Manufacturer>
 <Model>Wash LED 36x18W</Model>
 <Type>Moving Head</Type>
 <Channel Name="Pan" Preset="PositionPan"/>
 <Channel Name="Tilt" Preset="PositionTilt"/>
 <Channel Name="Pan/Tilt speed" Preset="SpeedPanTiltFastSlow"/>
 <Channel Name="Master dimmer" Preset="IntensityMasterDimmer"/>
 <Channel Name="Red" Preset="IntensityRed"/>
 <Channel Name="Green" Preset="IntensityGreen"/>
 <Channel Name="Blue" Preset="IntensityBlue"/>
 <Channel Name="White" Preset="IntensityWhite"/>
 <Channel Name="Amber" Preset="IntensityAmber"/>
 <Channel Name="UV" Preset="IntensityUV"/>
 <Channel Name="Strobe" Preset="ShutterStrobeSlowFast"/>
 <Channel Name="Zoom" Preset="BeamZoomSmallBig"/>
 <Channel Name="Macro">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="30" Preset="ColorMacro" Res1="#ffffff">RGBW full</Capability>
  <Capability Min="31" Max="39" Preset="ColorMacro" Res1="#ff0000">Red</Capability>
  <Capability Min="40" Max="49" Preset="ColorMacro" Res1="#00ff00">Green</Capability>
  <Capability Min="50" Max="59" Preset="ColorMacro" Res1="#0000ff">Blue</Capability>
  <Capability Min="60" Max="69" Preset="ColorMacro">Color mixing 1</Capability>
  <Capability Min="70" Max="79" Preset="ColorMacro">Color mixing 2</Capability>
  <Capability Min="80" Max="89" Preset="ColorMacro">Color mixing 3</Capability>
  <Capability Min="90" Max="99" Preset="ColorMacro">Color mixing 4</Capability>
  <Capability Min="100" Max="200">Auto mode 1</Capability>
  <Capability Min="201" Max="250">Auto mode 2</Capability>
  <Capability Min="251" Max="255">Sound active</Capability>
 </Channel>
 <Channel Name="Macro speed">
  <Group Byte="0">Speed</Group>
  <Capability Min="0" Max="255" Preset="SlowToFast">Macro speed (Slow to fast) [work with CH11(100-250)]</Capability>
 </Channel>
 <Channel Name="Pan fine" Preset="PositionPanFine"/>
 <Channel Name="Tilt fine" Preset="PositionTiltFine"/>
 <Channel Name="Reset">
  <Group Byte="0">Maintenance</Group>
  <Capability Min="0" Max="249">No function</Capability>
  <Capability Min="250" Max="255" Preset="ResetAll">After 3 seconds reset</Capability>
 </Channel>
 <Channel Name="Reserved" Preset="NoFunction"/>
 <Mode Name="Standard">
  <Channel Number="0">Pan</Channel>
  <Channel Number="1">Tilt</Channel>
  <Channel Number="2">Pan/Tilt speed</Channel>
  <Channel Number="3">Master dimmer</Channel>
  <Channel Number="4">Red</Channel>
  <Channel Number="5">Green</Channel>
  <Channel Number="6">Blue</Channel>
  <Channel Number="7">White</Channel>
  <Channel Number="8">Amber</Channel>
  <Channel Number="9">UV</Channel>
  <Channel Number="10">Strobe</Channel>
  <Channel Number="11">Zoom</Channel>
  <Channel Number="12">Macro</Channel>
  <Channel Number="13">Macro speed</Channel>
  <Channel Number="14">Pan fine</Channel>
  <Channel Number="15">Tilt fine</Channel>
  <Channel Number="16">Reset</Channel>
  <Channel Number="17">Reserved</Channel>
 </Mode>
 <Physical>
  <Bulb Type="LED" Lumens="0" ColourTemperature="0"/>
  <Dimensions Weight="11.5" Width="370" Height="460" Depth="330"/>
  <Lens Name="Other" DegreesMin="15" DegreesMax="60"/>
  <Focus Type="Head" PanMax="540" TiltMax="290"/>
  <Technical PowerConsumption="540" DmxConnector="3-pin"/>
 </Physical>
</FixtureDefinition>
