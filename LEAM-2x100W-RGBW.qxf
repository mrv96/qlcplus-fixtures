  <Capability Min="0" Max="255">effetti</Capability>
 </Channel>
 <Channel Name="Color macro" Preset="ColorMacro"/>
 <Channel Name="Red" Preset="IntensityRed"/>
 <Channel Name="Green" Preset="IntensityGreen"/>
 <Channel Name="Blue" Preset="IntensityBlue"/>
 <Channel Name="White" Preset="IntensityWhite"/>
 <Mode Name="8-CH">
  <Channel Number="0" ActsOn="0">Master dimmer</Channel>
  <Channel Number="1" ActsOn="1">Strobe</Channel>
  <Channel Number="2" ActsOn="2">effetti</Channel>
  <Channel Number="3" ActsOn="3">Color macro</Channel>
  <Channel Number="4" ActsOn="4">Red</Channel>
  <Channel Number="5" ActsOn="5">Green</Channel>
  <Channel Number="6" ActsOn="6">Blue</Channel>
  <Channel Number="7" ActsOn="7">White</Channel>
 </Mode>
 <Physical>
  <Bulb Type="LED" Lumens="3000" ColourTemperature="6000"/>
