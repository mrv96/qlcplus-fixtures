 </Channel>
 <Channel Name="Stop / Strobe">
  <Group Byte="0">Shutter</Group>
  <Capability Min="0" Max="3">Closed</Capability>
  <Capability Min="4" Max="103">Strobe (slow 1 flash/sec to fast 12 flashes/sec)</Capability>
  <Capability Min="104" Max="107">Open</Capability>
  <Capability Min="108" Max="207">Pulsation (Slow 30rpm to fast 360rpm)</Capability>
  <Capability Min="208" Max="212">Open</Capability>
  <Capability Min="213" Max="225">Random slow strobe</Capability>
  <Capability Min="226" Max="238">Random medium strobe</Capability>
  <Capability Min="239" Max="251">Random fast strobe</Capability>
  <Capability Min="252" Max="255">Open</Capability>
 </Channel>
 <Channel Name="Dimmer">
  <Group Byte="0">Intensity</Group>
  <Capability Min="0" Max="255">Intensity 0 to 100%</Capability>
 </Channel>
 <Channel Name="Static Gobo Change">
  <Group Byte="0">Gobo</Group>
  <Capability Min="0" Max="39" Preset="GoboMacro" Res1="ClayPaky/gobo00011.png">Open</Capability>
  <Capability Min="40" Max="41" Preset="GoboMacro" Res1="Others/gobo00007.png"></Capability>
  <Capability Min="43" Max="45" Preset="GoboMacro" Res1="ClayPaky/gobo00027.png">8</Capability>
 </Channel>
 <Channel Name="Prism Insertion">
  <Group Byte="0">Prism</Group>
  <Capability Min="0" Max="127">Prism excluded</Capability>
  <Capability Min="128" Max="255">Prism inserted (0%-100%: 0.36 sec)</Capability>
 </Channel>
 <Channel Name="Prism Rotation">
  <Group Byte="0">Prism</Group>
  <Capability Min="0" Max="20">Position 0°</Capability>
  <Capability Min="21" Max="41">Position 90°</Capability>
  <Capability Min="42" Max="62">Position 180°</Capability>
  <Capability Min="63" Max="83">Position 270°</Capability>
  <Capability Min="84" Max="104">Position 360°</Capability>
  <Capability Min="105" Max="126">Position 450°</Capability>
  <Capability Min="127" Max="127">Position 540°</Capability>
  <Capability Min="128" Max="190">Rotation (Fast 43rpm to slow 1.1rph)</Capability>
  <Capability Min="191" Max="192">Stop</Capability>
  <Capability Min="193" Max="255">Rotation (Slow 1.1rph to fast 43rpm)</Capability>
 </Channel>
 <Channel Name="speed Movement">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">Movement (0%-100%: 0.33 sec)</Capability>
 </Channel>
 <Channel Name="Frost">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">Frost insertion (excluded to inserted)</Capability>
 </Channel>
 <Channel Name="Focus">
  <Group Byte="0">Beam</Group>
  <Capability Min="0" Max="255">Focus (0%: Distant to 100%: Near)</Capability>
 </Channel>
 <Channel Name="Pan">
  <Group Byte="0">Pan</Group>
  <Capability Min="0" Max="255">Pan coarse (0° to 540°)</Capability>
 </Channel>
 <Channel Name="Pan Fine">
  <Group Byte="1">Pan</Group>
  <Capability Min="0" Max="255">Pan Fine (0.008°)</Capability>
 </Channel>
