  <Capability Min="49" Max="55" Preset="ColorMacro" Res1="#55aa00">Green</Capability>
  <Capability Min="56" Max="62" Preset="ColorMacro" Res1="#e2cf00">Yellow Dark</Capability>
  <Capability Min="63" Max="69" Preset="ColorMacro" Res1="#e30082">Magenta</Capability>
  <Capability Min="70" Max="76" Preset="ColorMacro" Res1="#5500ff">UV</Capability>
  <Capability Min="77" Max="83" Preset="ColorMacro" Res1="#004f99">Blue</Capability>
